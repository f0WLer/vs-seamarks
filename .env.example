# Copy this file to .env and fill in local paths. .env is gitignored.

# Vintage Story install directory (contains VintagestoryAPI.dll / VintagestoryLib.dll)
VINTAGE_STORY_PATH=C:\Program Files (x86)\Vintagestory-1.22

# Vintage Story mods folder (where built Debug zips are copied for testing)
MODS_PATH=C:\Users\YOURNAME\AppData\Roaming\VintagestoryData\Mods

# A sandbox --dataPath for F5 debugging (.vscode/launch.json), kept separate from your real game
# profile so the loose Debug build never loads twice alongside an installed copy.
DEBUG_DATA_PATH=C:\Users\YOURNAME\AppData\Roaming\VintagestoryDataDebug
