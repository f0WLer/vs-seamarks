{
	code: "lenspanelmold",
	class: "Block",
	// Same treatment as the base game's tool molds: a block for legacy pickup reasons, but placed and
	// carried like an item.
	behaviors: [
		{ name: "GroundStorable", properties: { layout: "SingleCenter" } },
		{ name: "Unplaceable" },
		{ name: "RightClickPickup" }
	],
	variantgroups: [
		{ code: "color", states: ["blue", "red", "fire"] },
		{ code: "materialtype", states: ["raw"] }
	],
	shape: { base: "seamarks:block/lenspanelmold" },
	textures: {
		"other": { base: "game:block/clay/{color}clay" },
		"floor": { base: "game:block/clay/{color}clay" }
	},
	attributes: {
		reinforcable: true,
		handbook: { groupBy: ["lenspanelmold-*"] }
	},
	// Beehive door count picks the fired color, mirroring the base game's blade mold exactly. Pit kiln
	// firing below only ever has one outcome per raw color, so it uses the plain combustible props instead.
	attributesByType: {
		"lenspanelmold-red-raw": {
			beehivekiln: {
				"0": { type: "block", code: "lenspanelmold-tan-fired" },
				"1": { type: "block", code: "lenspanelmold-orange-fired" },
				"2": { type: "block", code: "lenspanelmold-red-fired" },
				"3": { type: "block", code: "lenspanelmold-brown-fired" }
			}
		},
		"lenspanelmold-blue-raw": {
			beehivekiln: {
				"0": { type: "block", code: "lenspanelmold-cream-fired" },
				"1": { type: "block", code: "lenspanelmold-gray-fired" },
				"2": { type: "block", code: "lenspanelmold-black-fired" },
				"3": { type: "block", code: "lenspanelmold-black-fired" }
			}
		},
		"lenspanelmold-fire-raw": {
			beehivekiln: {
				"0": { type: "block", code: "lenspanelmold-fire-fired" },
				"1": { type: "block", code: "lenspanelmold-fire-fired" },
				"2": { type: "block", code: "lenspanelmold-fire-fired" },
				"3": { type: "block", code: "lenspanelmold-fire-fired" }
			}
		}
	},
	combustiblePropsByType: {
		"lenspanelmold-fire-raw": {
			meltingPoint: 650,
			meltingDuration: 45,
			smeltedRatio: 1,
			smeltingType: "fire",
			smeltedStack: { type: "block", code: "lenspanelmold-fire-fired" },
			requiresContainer: false
		},
		"lenspanelmold-blue-raw": {
			meltingPoint: 650,
			meltingDuration: 45,
			smeltedRatio: 1,
			smeltingType: "fire",
			smeltedStack: { type: "block", code: "lenspanelmold-blue-fired" },
			requiresContainer: false
		},
		"lenspanelmold-red-raw": {
			meltingPoint: 650,
			meltingDuration: 45,
			smeltedRatio: 1,
			smeltingType: "fire",
			smeltedStack: { type: "block", code: "lenspanelmold-earthyorange-fired" },
			requiresContainer: false
		}
	},
	blockmaterial: "Ceramic",
	creativeinventory: { "general": ["*"] },
	replaceable: 700,
	resistance: 1.5,
	maxStackSize: 8,
	lightAbsorption: 0,
	sounds: { walk: "walk/stone" },
	collisionbox: { x1: 0.0625, y1: 0, z1: 0.0625, x2: 0.9375, y2: 0.125, z2: 0.9375 },
	selectionbox: { x1: 0.0625, y1: 0, z1: 0.0625, x2: 0.9375, y2: 0.125, z2: 0.9375 },
	sideopaque: { all: false },
	sidesolid: { all: false },
	// Matches the base game's tool molds (their generic, non-anvil/helvehammer fallback transform).
	guiTransform: {
		translation: { x: 0, y: 3, z: 0 },
		origin: { x: 0.5, y: 0.0625, z: 0.5 },
		scale: 1.33
	},
	tpHandTransform: {
		translation: { x: -1, y: -0.6, z: -1.05 },
		rotation: { x: -87, y: 9, z: 4 },
		origin: { x: 0.5, y: 0.125, z: 0.5 },
		scale: 0.5
	},
	groundTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: 0, y: -45, z: 0 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 2.2
	}
}
