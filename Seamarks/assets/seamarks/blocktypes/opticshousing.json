{
	code: "opticshousing",
	class: "BlockOpticsHousing",
	entityClass: "BlockEntityOpticsHousing",
	// Texture keys live here because Model Creator rewrites a shape's embedded textures to absolute local
	// paths every time it saves, and those don't resolve at runtime. The key has to match the shape's own
	// face codes; a custom shape doesn't get the "all" fallback, which only covers shapes using the six
	// cardinal-direction face codes.
	//
	// Same polished brass the argand lamp's reflector uses, so a fitted housing reads as one piece with it.
	// The blocktype's own shape is the bare housing with empty panel mounts. BlockEntityOpticsHousing
	// replaces it with a mesh that has the panels grafted in, chosen by beam count, so both texture keys
	// have to resolve here: brass for the housing and covers, glass for the lens panels.
	shape: { base: "seamarks:block/lighthouse/opticshousing" },
	textures: {
		"brass": { base: "game:item/resource/plate/brass" },
		"glass": { base: "game:block/glass/plain" }
	},
	// Each housing carries its own beam signature, so two of them are never interchangeable and must
	// never merge in a slot.
	maxstacksize: 1,
	blockmaterial: "Glass",
	lightAbsorption: 0,
	resistance: 1,
	sidesolid: { all: false },
	sideopaque: { all: false },
	replaceable: 500,
	selectionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 },
	collisionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 },
	guiTransform: {
		translation: { x: 0.55, y: 2.75, z: 0 }
	},
	tpHandTransform: {
		translation: { x: -1.75, y: -1.62, z: -1.51 },
		rotation: { x: -158.82, y: -149.1, z: 81.2 },
		scale: 0.4
	},
	groundTransform: { scale: 2.5 },
	creativeinventory: { "general": ["*"] }
}
