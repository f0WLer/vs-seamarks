[
	{
		// Grid-craftable stand-ins for the Glassmaking cast/anneal/finish chain, so a lens panel is still
		// reachable without that mod. Removed in SeamarksModSystem.AssetsFinalize when Glassmaking is
		// present, so its intended pipeline stays the only route once it's installed.
		//
		// This sits inside the first recipe and not up between the brackets on purpose. The loader reads a
		// comment that's a direct child of the array as an array entry of its own, fails to make a recipe
		// out of it, and logs one error per line. Vanilla's own recipe files keep their comments inside an
		// object for the same reason.
		ingredientPattern: "AB,_C",
		ingredients: {
			"A": { type: "block", code: "game:glassslab-plain-down-free" },
