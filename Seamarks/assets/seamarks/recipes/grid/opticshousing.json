[
	{
		// allowedVariants keeps the plate, nails and rod to the three bronzes, matching the beacon's own
		// recipe; a bare wildcard would let plain iron, gold and the rest qualify too.
		ingredientPattern: "ABA,C_C,ABA",
		ingredients: {
			"A": { type: "item", code: "game:metalnailsandstrips-*", allowedVariants: ["bismuthbronze", "tinbronze", "blackbronze"] },
			"B": { type: "item", code: "game:rod-*", allowedVariants: ["bismuthbronze", "tinbronze", "blackbronze"] },
			"C": { type: "item", code: "game:metalplate-*", allowedVariants: ["bismuthbronze", "tinbronze", "blackbronze"] }
		},
		width: 3,
		height: 3,
		output: { type: "block", code: "seamarks:opticshousing" }
	}
]
